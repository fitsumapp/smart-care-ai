# MedPulse AI Vision Configuration
MEDPULSE_SERVER_URL=https://your-domain.com

# Location Configuration
# Example for Room: LOCATION_NAME=Room 5, LOCATION_TYPE=ROOM
# Example for Corridor: LOCATION_NAME=Corridor 2nd Floor, LOCATION_TYPE=CORRIDOR
# Example for Stairs: LOCATION_NAME=Staircase Block-B, LOCATION_TYPE=STAIRS
# Example for Bathroom: LOCATION_NAME=Restroom Ward-A, LOCATION_TYPE=BATHROOM
LOCATION_NAME=Room 5
LOCATION_TYPE=ROOM
BED_NUMBER=General
STATION_API_KEY=medpulse-station-secret-key

# Camera & UI Settings
USE_PI_CAMERA=True
SHOW_PREVIEW=True
CAMERA_INDEX=0

# Detection Tuning
FALL_ANGLE_THRESHOLD=65.0
FALL_HIP_Y_THRESHOLD=0.70
FALL_CONFIRM_SECS=3.0
TREMOR_THRESHOLD=0.022
TREMOR_CONFIRM_FRAMES=15
COOLDOWN_SECONDS=45.0
