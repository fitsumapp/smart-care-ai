<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Supervisor Login | AI Nurse Pro</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background: #f4f7f9; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); width: 400px; padding: 40px; background: white; }
        .btn-primary { background: #0056b3; border: none; border-radius: 10px; padding: 12px; }
        .form-control { border-radius: 10px; padding: 12px; }
        .logo-text { color: #0056b3; font-weight: bold; text-align: center; margin-bottom: 30px; }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="logo-text"><h3>AI NURSE <span class="text-info">PRO</span></h3></div>
        <h5 class="text-center mb-4">Supervisor Login</h5>
        
        {% if messages %}
            {% for message in messages %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
        {% endif %}

        <form method="POST">
            {% csrf_token %}
            <div class="mb-3">
                <label class="form-label">Username</label>
                <input type="text" name="username" class="form-control" required placeholder="Enter username">
            </div>
            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password" name="password" class="form-control" required placeholder="Enter password">
            </div>
            <button type="submit" class="btn btn-primary w-100">Sign In</button>
        </form>
    </div>
</body>
</html>
