# ============================================================
# MedPulse Smart-Care AI — Environment Template (.env.example)
# Rename this file to .env on your server / cPanel
# ============================================================

# --- Security ---
SECRET_KEY=generate-a-strong-random-secret-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# --- Database Options ---
# Option 1: SQLite (Default & easiest for Shared Hosting)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# Option 2: MySQL (Recommended for cPanel Shared Hosting)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=cpanel_user_medpulse
# DB_USER=cpanel_user_dbuser
# DB_PASSWORD=your_mysql_password
# DB_HOST=localhost
# DB_PORT=3306

# Option 3: PostgreSQL (For Cloud VPS)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=medpulse_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password
# DB_HOST=localhost
# DB_PORT=5432

# --- Hardware / Station Security ---
STATION_API_KEY=medpulse-station-secret-key

# --- SMS Escalation (Twilio - Optional) ---
# TWILIO_SID=your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_FROM_NUMBER=+1234567890
# NOTIFICATION_PHONE_NUMBER=+251912345678
